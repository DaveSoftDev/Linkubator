@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<div class="min-h-screen bg-slate-950 text-slate-100">
    <div class="mx-auto flex min-h-screen max-w-5xl items-center px-6 py-20">
        <div class="w-full rounded-2xl border border-slate-800 bg-slate-900/80 p-8 shadow-2xl shadow-slate-950/50 sm:p-12">
            <p class="mb-4 inline-flex rounded-full border border-cyan-500/40 bg-cyan-500/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-cyan-300">
                Fundaciones
            </p>
            <h1 class="text-4xl font-bold tracking-tight text-white sm:text-5xl">
                Linkubator
            </h1>
            <p class="mt-6 max-w-2xl text-lg text-slate-300">
                Base técnica del MVP0 preparada para arrancar la aplicación web, compilar estilos con Tailwind y dejar el entorno listo para el siguiente sprint.
            </p>
            <div class="mt-8 flex flex-wrap gap-4 text-sm text-slate-200">
                <span class="rounded-full border border-slate-700 bg-slate-800 px-3 py-2">Razor Pages</span>
                <span class="rounded-full border border-slate-700 bg-slate-800 px-3 py-2">HTTPS local</span>
                <span class="rounded-full border border-slate-700 bg-slate-800 px-3 py-2">Tailwind integrado</span>
            </div>
        </div>
    </div>
</div>
