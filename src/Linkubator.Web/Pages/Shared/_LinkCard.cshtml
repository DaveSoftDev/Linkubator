@using Linkubator.Web.Models.AppDashboard
@model LinkCardViewModel
@{
    string returnUrl = $"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";
}

<article class="link-card" aria-label="Enlace: @Model.Title">
    <div class="link-card__thumb link-card__thumb--@Model.AccentClass">
        @if (string.IsNullOrWhiteSpace(Model.ImageUrl))
        {
            <div class="link-card__brand-placeholder" aria-hidden="true">
                <span class="brand-mark"><partial name="_BrandMark" /></span>
            </div>
        }
        else
        {
            <div class="link-card__thumb-overlay" aria-hidden="true">
                <img src="@Model.ImageUrl" alt="@(string.IsNullOrWhiteSpace(Model.Title) ? Model.Url : Model.Title)" />
            </div>
        }
        <h4>@Model.Title</h4>
    </div>

    <div class="link-card__body">
        <h4 class="link-card__list-title">
            <a href="@Model.Url" rel="noopener noreferrer" target="_blank" aria-label="@($"Abrir {Model.Title} (se abre en una pestaña nueva)")">@Model.Title</a>
        </h4>
        <div class="link-card__meta">
            <div class="link-card__labels">
                <div class="link-card__details">
                    <span class="link-card__collection">@Model.CollectionName</span>
                    <span class="link-card__list-domain">@Model.Domain</span>
                </div>
                @if (Model.IsPublic)
                {
                    <span class="link-card__public" title="Este enlace es público">
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a18 18 0 0 1 0 18 18 18 0 0 1 0-18Z" /></svg>
                        Público
                    </span>
                }
                else
                {
                    <span class="link-card__private" title="Este enlace es privado">
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="5" y="10" width="14" height="11" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>
                        Privado
                    </span>
                }
            </div>
            <div class="link-card__actions">
                <a asp-page="/App/Links/Edit" asp-route-id="@Model.Id" asp-route-ru="@returnUrl" aria-label="Editar enlace @Model.Title" title="Editar enlace">
                    <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M12 20H21"></path><path d="M16.5 3.5a2.12 2.12 0 1 1 3 3L7 19l-4 1 1-4L16.5 3.5Z"></path></svg>
                </a>
                <a asp-page="/App/Links/Move" asp-route-id="@Model.Id" asp-route-ru="@returnUrl" aria-label="Mover enlace @Model.Title" title="Mover a otra colección">
                    <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"></path></svg>
                </a>
                <a asp-page="/App/Links/Delete" asp-route-id="@Model.Id" asp-route-ru="@returnUrl" aria-label="Eliminar enlace @Model.Title" title="Eliminar enlace">
                    <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M3 6H21"></path><path d="M8 6V4H16V6"></path><path d="M19 6L18 20H6L5 6"></path><path d="M10 11V17"></path><path d="M14 11V17"></path></svg>
                </a>
                <a class="link-card__open" href="@Model.Url" aria-label="@($"Abrir {Model.Title} (se abre en una pestaña nueva)")" rel="noopener noreferrer" target="_blank" title="Abrir @Model.Domain">
                    <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M7 17L17 7"></path><path d="M8 7H17V16"></path></svg>
                </a>
            </div>
        </div>

        <p>@Model.Description</p>

        <div class="link-card__footer">
            <span class="link-card__domain">@Model.Domain</span>
        </div>
    </div>
</article>
