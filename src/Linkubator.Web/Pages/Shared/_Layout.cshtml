@inject Microsoft.Extensions.Options.IOptions<Linkubator.Web.Options.PublicOriginOptions> PublicOriginOptions
@{
    string pageTitle = ViewData["Title"] as string ?? "Linkubator";
    string metaTitle = (ViewData["MetaTitle"] as string) ?? $"{pageTitle} - Linkubator";
    string metaDescription = (ViewData["MetaDescription"] as string) ?? "Linkubator - base técnica de Linkubator";
    string? canonicalUrl = ViewData["CanonicalUrl"] as string;
    if (canonicalUrl is null
        && Uri.TryCreate(PublicOriginOptions.Value.Origin, UriKind.Absolute, out Uri? publicOrigin)
        && (publicOrigin.Scheme == Uri.UriSchemeHttp || publicOrigin.Scheme == Uri.UriSchemeHttps)
        && publicOrigin.AbsolutePath == "/"
        && string.IsNullOrEmpty(publicOrigin.Query)
        && string.IsNullOrEmpty(publicOrigin.Fragment)
        && string.IsNullOrEmpty(publicOrigin.UserInfo))
    {
        canonicalUrl = $"{publicOrigin.GetLeftPart(UriPartial.Authority)}{Context.Request.PathBase}{Context.Request.Path}";
    }
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@metaTitle</title>
    <meta name="title" content="@metaTitle" />
    <meta name="description" content="@metaDescription" />
    <meta name="robots" content="@(ViewData["Robots"] as string ?? "index, follow")" />
    @if (!string.IsNullOrWhiteSpace(canonicalUrl))
    {
    <link rel="canonical" href="@canonicalUrl" />
    }
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <partial name="_Favicons" />
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/brand.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/footer.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/public-actions.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-slate-950 text-slate-100 antialiased">
    <div class="min-h-screen">
        <main role="main" class="@(ViewData["MainClass"] as string ?? "mx-auto max-w-5xl px-4 py-10")">
            @RenderBody()
        </main>
    </div>

    <script src="~/js/site.js" defer asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
