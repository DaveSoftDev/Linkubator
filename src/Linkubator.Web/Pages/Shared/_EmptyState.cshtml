@using Linkubator.Web.Models.Presentation
@model EmptyStateViewModel

<div class="empty-state" role="status" aria-live="polite">
    <h2>@Model.Title</h2>
    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <p>@Model.Description</p>
    }
    @if (!string.IsNullOrWhiteSpace(Model.ActionUrl) && !string.IsNullOrWhiteSpace(Model.ActionText))
    {
        <p><a class="secondary-button" href="@Model.ActionUrl">@Model.ActionText</a></p>
    }
</div>
