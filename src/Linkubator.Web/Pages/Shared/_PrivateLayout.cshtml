@using Linkubator.Web.DevelopmentIdentity
@using Linkubator.Web.Models.AppSidebar
@inject IWebUserProfile CurrentUser

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Linkubator</title>
    <meta name="title" content="@ViewData["Title"] - Linkubator" />
    <meta name="description" content="Área privada de Linkubator" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
</head>
<body class="private-shell">
    <div class="private-page">
        <div class="@(Context.Request.Cookies["sidebar-collapsed"] == "true" ? "app-layout sidebar-collapsed" : "app-layout")">
            @{
                AppSidebarUserViewModel currentSidebarUser = new()
                {
                    Name = CurrentUser.Name,
                    Alias = CurrentUser.Alias,
                    Email = CurrentUser.Email,
                };

                AppSidebarViewModel sidebarModel = Model is Linkubator.Web.Pages.App.PrivatePageModel privatePageModel
                    ? privatePageModel.Sidebar
                    : AppSidebarViewModelFactory.CreateSidebar(AppSidebarSelectionKind.Home, [], currentSidebarUser);
            }

            @await Html.PartialAsync("~/Pages/Shared/_AppSidebar.cshtml", sidebarModel)

            <button class="mobile-nav-toggle" type="button" aria-expanded="false" aria-controls="app-sidebar" aria-label="Abrir menú">
                <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                    <path d="M4 7H20M4 12H20M4 17H20"></path>
                </svg>
            </button>

            @RenderBody()
        </div>

        <footer class="private-footer">
            <p>Área privada Linkubator · 2026</p>
        </footer>
    </div>

    <script src="~/js/site.js" defer asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
