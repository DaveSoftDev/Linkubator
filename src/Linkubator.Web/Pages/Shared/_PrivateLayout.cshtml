<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Área privada de Linkubator" />
    <title>@ViewData["Title"] - Linkubator</title>
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
</head>
<body class="private-shell">
    <div class="private-page">
        <div class="app-layout" role="application" aria-label="Panel principal de Linkubator">
            <button class="mobile-nav-toggle" type="button" aria-expanded="false" aria-controls="app-sidebar" aria-label="Abrir menú">
                <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                    <path d="M4 7H20M4 12H20M4 17H20"></path>
                </svg>
            </button>

            @{ 
                var sidebarModel = Model is Linkubator.Web.Pages.App.DashboardModel dashboardModel
                    ? dashboardModel.Sidebar
                    : Linkubator.Web.Models.AppSidebar.AppSidebarViewModelFactory.CreateDefault();
            }

            @await Html.PartialAsync("~/Pages/Shared/_AppSidebar.cshtml", sidebarModel)

            @RenderBody()
        </div>

        <footer class="private-footer">
            <p>Área privada Linkubator · 2026</p>
        </footer>
    </div>

    <script src="~/js/site.js" defer asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
