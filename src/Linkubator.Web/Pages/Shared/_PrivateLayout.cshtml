@using Linkubator.Web.Models.AppSidebar

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Linkubator</title>
    <meta name="title" content="@ViewData["Title"] - Linkubator" />
    <meta name="description" content="Área privada de Linkubator" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <partial name="_Favicons" />
    <environment include="Production">
        <link rel="stylesheet" href="~/css/private.bundle.css" asp-append-version="true" />
    </environment>
    <environment exclude="Production">
        <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/brand.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/private.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/footer.css" asp-append-version="true" />
    </environment>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="private-shell">
    <a class="private-skip" href="#main-content">Saltar al contenido</a>
    <div class="private-page">
        <div class="@(Context.Request.Cookies["sidebar-collapsed"] == "true" ? "app-layout sidebar-collapsed" : "app-layout")">
            @{
                AppSidebarViewModel sidebarModel = Model is Linkubator.Web.Pages.App.PrivatePageModel privatePageModel
                    ? privatePageModel.Sidebar
                    : throw new InvalidOperationException("The private layout requires a private page model.");
            }

            @await Html.PartialAsync("~/Pages/Shared/_AppSidebar.cshtml", sidebarModel)

            <button class="mobile-nav-toggle" type="button" aria-expanded="false" aria-controls="app-sidebar" aria-label="Abrir menú">
                <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                    <path d="M4 7H20M4 12H20M4 17H20"></path>
                </svg>
            </button>

            @RenderBody()
        </div>

        <footer class="private-footer">
            <p><span>Área privada Linkubator</span><span>Copyright 2026. <a class="footer-link" asp-page="/Privacy">Privacidad</a></span></p>
        </footer>
    </div>

    <environment include="Production">
        <script src="~/js/private.bundle.js" defer asp-append-version="true"></script>
    </environment>
    <environment exclude="Production">
        <script src="~/js/site.js" defer asp-append-version="true"></script>
        <script src="~/js/required-validation.js" defer asp-append-version="true"></script>
    </environment>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
