@page "/app"
@using Linkubator.Web.Models.AppDashboard
@model Linkubator.Web.Pages.App.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
    bool isListView = Request.Cookies["links-view"] == "list";
}

<main id="main-content" class="app-main" tabindex="-1">
    <header class="main-header">
        <div>
            <p class="main-eyebrow">Gestiona tus enlaces</p>
            <h2>Dashboard</h2>
        </div>
    </header>

    <section class="main-section" aria-labelledby="main-section-title">
        <h3 id="main-section-title">Crear enlace rápido</h3>
        <form method="post" asp-page-handler="QuickAdd" id="quick-new-form" data-required-validation>
            @await Html.PartialAsync("~/Pages/Shared/_PageAlert.cshtml", Model.QuickAddAlert)
            <div class="main-section__form">
                <label for="quick-url" class="main-section__label">URL</label>
                <div class="main-section__field">
                    <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.07 0l2.83-2.83a5 5 0 1 0-7.07-7.07L10.5 4.5"></path><path d="M14 11a5 5 0 0 0-7.07 0L4.1 13.83a5 5 0 1 0 7.07 7.07l2.83-2.83"></path></svg>
                    <input asp-for="QuickUrl" id="quick-url" type="text" inputmode="url" autocomplete="url" required placeholder="https://ejemplo.com" aria-label="URL del nuevo enlace" data-quick-add-input aria-describedby="quick-url-error" data-required-message="@Linkubator.Application.Constants.LinkErrors.UrlRequired().Message" />
                </div>
                <span asp-validation-for="QuickUrl" id="quick-url-error" class="main-section__error" role="alert"></span>

                <div class="main-section__actions">
                    <button class="primary-button quick-add__main-trigger" type="submit">
                        <span>Añadir</span>
                    </button>

                    <div class="quick-add__menu-wrapper">
                        <button class="primary-button quick-add__secondary-trigger" type="button" aria-label="Más opciones para añadir un enlace" aria-expanded="false" aria-haspopup="true" aria-controls="quick-add-menu" data-quick-add-toggle>
                            <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M7 10L12 15L17 10"></path></svg>
                        </button>

                        <div class="quick-add__menu" id="quick-add-menu" hidden>
                            <a href="@Linkubator.Web.Constants.AppRoutes.LinkNew" class="quick-add__menu-item" data-quick-add-advanced>
                                Avanzado...
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </section>

    @await Html.PartialAsync("~/Pages/Shared/_SearchForm.cshtml", Model.SearchForm)

    <section aria-labelledby="recent-links-title">
        <div class="section-toolbar section-toolbar--links">
            <h3 id="recent-links-title">Enlaces recientes</h3>
            @if (Model.Cards.Count > 0)
            {
                @await Html.PartialAsync("~/Pages/Shared/_LinkViewSwitch.cshtml", "dashboard-links")
            }
        </div>
        @await Html.PartialAsync("~/Pages/Shared/_PageAlert.cshtml", Model.RecentLinksAlert)
        @if (string.IsNullOrWhiteSpace(Model.RecentLinksAlert.Message))
        {
        <div class="main-wrapper">
        @if (Model.Cards.Count == 0)
        {
            @await Html.PartialAsync("~/Pages/Shared/_EmptyState.cshtml", Model.EmptyState)
        }
        else
        {
            <div id="dashboard-links" class="@(isListView ? "links-grid links-grid--list" : "links-grid")" data-link-view-container aria-label="Lista de enlaces guardados">
                @foreach (LinkCardViewModel card in Model.Cards)
                {
                    @await Html.PartialAsync("~/Pages/Shared/_LinkCard.cshtml", card)
                }
            </div>
        }
        </div>
        }
    </section>
</main>


@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const invalidField = document.querySelector('#quick-new-form .input-validation-error');
            if (invalidField instanceof HTMLElement) {
                invalidField.focus();
                if (typeof invalidField.select === 'function' && invalidField.tagName === 'INPUT') {
                    invalidField.select();
                }
            }
        });
    </script>
}
