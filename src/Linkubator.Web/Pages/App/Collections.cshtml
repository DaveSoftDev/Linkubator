@page "/app/colecciones"
@using Linkubator.Application.Dtos.Models
@model Linkubator.Web.Pages.App.CollectionsModel
@{
    ViewData["Title"] = "Mis colecciones";
}

@section Styles {
    <link rel="stylesheet" href="~/css/collection-list.css" asp-append-version="true" />
}

<main id="main-content" class="app-main" tabindex="-1">
    <header class="main-header">
        <div>
            <p class="main-eyebrow">Organiza tus enlaces</p>
            <h2>Mis colecciones</h2>
        </div>
    </header>

    @await Html.PartialAsync("~/Pages/Shared/_LinkCreationNotice.cshtml")

    @await Html.PartialAsync("~/Pages/Shared/_ErrorSummary.cshtml", Model.ErrorSummary)
    @await Html.PartialAsync("~/Pages/Shared/_PageAlert.cshtml", Model.Alert)
    @await Html.PartialAsync("~/Pages/Shared/_SearchForm.cshtml", Model.SearchForm)

    <section aria-labelledby="collections-list-title">
        <div class="section-toolbar section-toolbar--collections">
          <h3 id="collections-list-title">Colecciones</h3>
          <a class="view-switch__button toolbar-tool" href="@Linkubator.Web.Constants.AppRoutes.CollectionNew">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 5V19M5 12H19"></path></svg>
            Crear colección
          </a>
        </div>
        <div class="main-wrapper">
        @if (Model.HasListingError)
        {
            @await Html.PartialAsync("~/Pages/Shared/_EmptyState.cshtml", Model.ListingError)
        }
        else if (Model.Collections.Count == 0)
        {
            @await Html.PartialAsync("~/Pages/Shared/_EmptyState.cshtml", Model.EmptyState)
        }
        else
        {
        <ul id="saved-collections" class="links-grid links-grid--list collections-list" aria-label="Colecciones existentes">
            @foreach (CollectionDto collection in Model.Collections)
            {
                <li class="link-card">
                    <article class="link-card__body" aria-label="Colección: @collection.Name">
                        <h4 class="link-card__list-title">
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 7V5a2 2 0 0 1 2-2h5l2 3h7a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7Z" /></svg>
                            @collection.Name
                        </h4>
                        @if (!string.IsNullOrWhiteSpace(collection.Description))
                        {
                            <p class="collections-list__description">@collection.Description</p>
                        }
                        <div class="collections-list__metadata">
                            <span class="collections-list__count">@collection.LinkCount @(collection.LinkCount == 1 ? "enlace" : "enlaces")</span>
                            @if (collection.IsPublic)
                            {
                                <span class="link-card__public"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a18 18 0 0 1 0 18 18 18 0 0 1 0-18Z" /></svg>Pública</span>
                            }
                            else
                            {
                                <span class="collections-list__private"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="5" y="10" width="14" height="11" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>Privada</span>
                            }
                        </div>
                        <div class="link-card__actions">
                            <a href="@string.Format(System.Globalization.CultureInfo.InvariantCulture, Linkubator.Web.Constants.AppRoutes.CollectionEdit, collection.Id)" aria-label="Editar colección @collection.Name" title="Editar">
                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 20h4L19 9l-4-4L4 16zM13.5 6.5l4 4" /></svg>
                            </a>
                            <a class="main-table__button--danger" href="@string.Format(System.Globalization.CultureInfo.InvariantCulture, Linkubator.Web.Constants.AppRoutes.CollectionDelete, collection.Id)" aria-label="Eliminar colección @collection.Name" title="Eliminar">
                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13" /></svg>
                            </a>
                        </div>
                    </article>
                </li>
            }
        </ul>
        @await Html.PartialAsync("~/Pages/Shared/_Pagination.cshtml", Model.Pagination)
        }
      </div>
    </section>
</main>
