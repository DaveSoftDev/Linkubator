@page "/app/enlaces/{id}/editar"
@model Linkubator.Web.Pages.App.Links.EditModel
@{
    ViewData["Title"] = "Editar enlace";
}

<main id="main-content" class="app-main" tabindex="-1">
    <header class="main-header">
        <div>
            <p class="main-eyebrow">Gestiona tus enlaces</p>
            <h2>Editar enlace</h2>
        </div>
    </header>

    @if (Model.ResourceUnavailable is not null)
    {
        @await Html.PartialAsync("~/Pages/Shared/_PrivateResourceUnavailable.cshtml", Model.ResourceUnavailable)
    }
    else
    {
        <form method="post" id="link-edit-form" class="collection-form">
            <input type="hidden" name="ru" value="@Model.ReturnRoute" />
            <div class="collection-form__heading">
                <span class="collection-form__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false"><path d="M4 20h4L19 9l-4-4L4 16zM13.5 6.5l4 4" /></svg>
                </span>
                <h3>Detalles del enlace</h3>
            </div>
            <div class="collection-form__heading">
                @await Html.PartialAsync("~/Pages/Shared/_ErrorSummary.cshtml", Model.ErrorSummary)
                @await Html.PartialAsync("~/Pages/Shared/_PageAlert.cshtml", Model.Alert)
            </div>
            @if (Model.LinkUrl.Length > 0)
            {
                <div class="collection-form__fields">
                    <p><strong>URL</strong><br /><code>@Model.LinkUrl</code></p>
                    <div class="collection-form__field">
                        <label asp-for="Input.CollectionId" for="link-collection">Colección</label>
                        <select asp-for="Input.CollectionId" id="link-collection" class="collection-form__collection-picker" data-current-collection-id="@Model.CurrentCollectionId?.ToString(System.Globalization.CultureInfo.InvariantCulture)" required aria-describedby="link-public-hint link-collection-error">
                            <option value="">Selecciona una colección</option>
                            @foreach (var collection in Model.Collections)
                            {
                                <option value="@collection.Id.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-public="@(collection.IsPublic ? "true" : "false")">@collection.Name</option>
                            }
                        </select>
                        <span asp-validation-for="Input.CollectionId" id="link-collection-error" class="collection-form__error"></span>
                    </div>
                    <div class="collection-form__field">
                        <label asp-for="Input.Title" for="link-title">Título <span class="collection-form__optional">Opcional</span></label>
                        <input asp-for="Input.Title" id="link-title" aria-describedby="link-title-error" />
                        <span asp-validation-for="Input.Title" id="link-title-error" class="collection-form__error"></span>
                    </div>
                    <div class="collection-form__field">
                        <label asp-for="Input.Description" for="link-description">Descripción <span class="collection-form__optional">Opcional</span></label>
                        <textarea asp-for="Input.Description" id="link-description" rows="4" aria-describedby="link-description-error"></textarea>
                        <span asp-validation-for="Input.Description" id="link-description-error" class="collection-form__error"></span>
                    </div>
                    <div class="collection-form__field">
                        <label asp-for="Input.Image" for="link-image">Imagen <span class="collection-form__optional">Opcional</span></label>
                        <input asp-for="Input.Image" id="link-image" type="text" inputmode="url" aria-describedby="link-image-error" />
                        <span asp-validation-for="Input.Image" id="link-image-error" class="collection-form__error"></span>
                    </div>
                    <div class="collection-form__privacy">
                        <input asp-for="Input.IsPublic" id="link-public" aria-describedby="link-public-hint link-public-error" disabled="@(!Model.CanMakePublic)" />
                        <label asp-for="Input.IsPublic" for="link-public">Hacer público</label>
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a18 18 0 0 1 0 18 18 18 0 0 1 0-18Z" /></svg>
                    </div>
                    <span id="link-public-hint" class="collection-form__optional" hidden="@Model.CanMakePublic">@Model.CollectionPrivacyHint</span>
                    <span asp-validation-for="Input.IsPublic" id="link-public-error" class="collection-form__error"></span>
                </div>
            }
            <div class="collection-form__actions">
                <a class="collection-form__cancel" href="@Model.ReturnRoute">Cancelar</a>
                @if (Model.LinkUrl.Length > 0)
                {
                    <button class="primary-button" type="submit">Guardar cambios</button>
                }
            </div>
        </form>
    }
</main>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const invalidField = document.querySelector('#link-edit-form .input-validation-error');
            if (invalidField instanceof HTMLElement) {
                invalidField.focus();
                if (typeof invalidField.select === 'function' && invalidField.tagName === 'INPUT') {
                    invalidField.select();
                }
            }

            const collection = document.querySelector('#link-collection');
            const isPublic = document.querySelector('#link-public');
            const privacyHint = document.querySelector('#link-public-hint');
            if (collection instanceof HTMLSelectElement && isPublic instanceof HTMLInputElement && privacyHint instanceof HTMLElement) {
                let requestedVisibility = isPublic.checked;
                isPublic.addEventListener('change', () => {
                    if (!isPublic.disabled) {
                        requestedVisibility = isPublic.checked;
                    }
                });

                const syncPrivacy = () => {
                    const selectedCollection = collection.selectedOptions[0];
                    const collectionChanged = selectedCollection?.value.length > 0
                        && selectedCollection.value !== collection.dataset.currentCollectionId;
                    const canMakePublic = !collectionChanged && selectedCollection?.dataset.public === 'true';
                    isPublic.disabled = !canMakePublic;
                    isPublic.checked = canMakePublic && requestedVisibility;

                    privacyHint.hidden = canMakePublic;
                    privacyHint.textContent = collectionChanged
                        ? 'Al cambiar de colección, el enlace pasará a ser privado.'
                        : selectedCollection?.value.length > 0 && selectedCollection.dataset.public === 'false'
                            ? 'Este enlace pertenece a una colección privada y no se puede hacer público.'
                            : 'Selecciona una colección pública para poder hacer público el enlace.';
                };

                collection.addEventListener('change', syncPrivacy);
                syncPrivacy();
            }
        });
    </script>
}
