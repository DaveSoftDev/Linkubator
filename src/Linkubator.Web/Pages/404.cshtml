@page "/404"
@{
    Layout = "_Layout";
    ViewData["Title"] = "Página no encontrada";
    ViewData["MetaDescription"] = "Esta dirección no está disponible. Vuelve al inicio de Linkubator y sigue conectando ideas.";
    ViewData["Robots"] = "noindex, follow";
    ViewData["MainClass"] = "public-shell";
    Response.StatusCode = 404;
}

@section Styles {
    <link rel="stylesheet" href="~/css/public.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/not-found.css" asp-append-version="true" />
}

<a class="public-skip" href="#not-found-content">Saltar al contenido</a>
<header class="public-topbar public-container public-header">
    <a class="public-brand" href="/" aria-label="Linkubator, inicio">
        <span class="brand-mark" aria-hidden="true"><partial name="_BrandMark" /></span>
        <span>linkubator<span class="public-accent">.</span></span>
    </a>
    <partial name="_PublicAuthLinks" />
</header>

<div id="not-found-content" class="not-found public-container" tabindex="-1">
    <section class="not-found__hero" aria-labelledby="not-found-title">
        <div class="not-found__copy">
            <p class="public-eyebrow">Error 404 · Fuera de ruta</p>
            <h1 id="not-found-title">Este enlace se ha<br /><span class="public-accent">quedado suelto.</span></h1>
            <p class="public-intro">La dirección que has solicitado no existe o ya no está disponible. Pero todavía hay muchas ideas por conectar.</p>
            <a class="landing-button" href="/">Volver al inicio <span aria-hidden="true">↗</span></a>
            <p class="not-found__note">Menos enlaces perdidos. Empecemos por este.</p>
        </div>
        <div class="not-found__illustration" aria-hidden="true">
            <span class="not-found__coordinate">LINKUBATOR / CONEXIÓN NO ENCONTRADA</span>
            <svg viewBox="0 0 360 260" focusable="false">
                <circle class="not-found__orbit" cx="180" cy="130" r="104" />
                <circle class="not-found__orbit" cx="180" cy="130" r="74" />
                <path class="not-found__trail" d="M25 218 96 182M264 78l71-36" />
                <circle class="not-found__node" cx="25" cy="218" r="5" />
                <circle class="not-found__node" cx="335" cy="42" r="5" />
                <g transform="translate(180 130) rotate(-35)" class="not-found__chain">
                    <path d="M-25-30h-25a30 30 0 0 0-30 30 30 30 0 0 0 30 30h25M25-30h25A30 30 0 0 1 80 0a30 30 0 0 1-30 30H25" />
                    <path class="not-found__break" d="m-9-13-6 13h19l-7 14" />
                </g>
            </svg>
            <span class="not-found__code">404<span>Un desvío, no un final.</span></span>
        </div>
    </section>
    <div class="not-found__reassurance"><span class="public-accent" aria-hidden="true">↗</span><p>Las buenas ideas siguen ahí.<br /><span>Vuelve al inicio y encuentra tu próximo descubrimiento.</span></p></div>
</div>

<footer class="public-footer public-container">
    <a class="public-brand" href="/" aria-label="Linkubator, inicio">
        <span class="brand-mark" aria-hidden="true"><partial name="_BrandMark" /></span>
        <span>linkubator<span class="public-accent">.</span></span>
    </a>
    <div class="footer-caption">
        <p>Menos enlaces perdidos. Más ideas conectadas.</p>
        <span>Copyright 2026. <a class="footer-link" asp-page="/Privacy">Privacidad</a></span>
    </div>
    <nav class="footer-links" aria-label="Enlaces del pie de página"><a href="/">Volver al inicio <span aria-hidden="true">↗</span></a></nav>
</footer>
