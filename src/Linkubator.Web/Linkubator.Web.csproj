<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Linkubator.Application\Linkubator.Application.csproj" />
    <ProjectReference Include="..\Linkubator.Infrastructure\Linkubator.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="wwwroot\js\private.js;wwwroot\js\private.min.js;wwwroot\css\private.bundle.css;wwwroot\css\public.bundle.css;wwwroot\css\private.bundle.min.css;wwwroot\css\public.bundle.min.css" />
    <Content Include="wwwroot\js\private.js;wwwroot\css\private.bundle.css;wwwroot\css\public.bundle.css" />
  </ItemGroup>

  <Target Name="BuildTailwindCss" BeforeTargets="Build">
    <Exec Command="&quot;$(MSBuildProjectDirectory)\..\..\..\..\..\Tools\TailwindCSS\tailwindcss-windows-x64.exe&quot; -c tailwind.config.js -i ./wwwroot/css/develop.css -o ./wwwroot/css/styles.css --minify" WorkingDirectory="$(MSBuildProjectDirectory)" Condition="Exists('$(MSBuildProjectDirectory)\..\..\..\..\..\Tools\TailwindCSS\tailwindcss-windows-x64.exe')" />
  </Target>

  <Target Name="BuildClientBundles" BeforeTargets="AssignTargetPaths;ResolveProjectStaticWebAssets" DependsOnTargets="BuildTailwindCss">
    <Exec Command="dotnet tool restore" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Exec Command="dotnet tool run bundle" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\wwwroot\js\private.min.js" DestinationFiles="$(MSBuildProjectDirectory)\wwwroot\js\private.js" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\wwwroot\css\private.bundle.min.css" DestinationFiles="$(MSBuildProjectDirectory)\wwwroot\css\private.bundle.css" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\wwwroot\css\public.bundle.min.css" DestinationFiles="$(MSBuildProjectDirectory)\wwwroot\css\public.bundle.css" SkipUnchangedFiles="true" />
  </Target>

</Project>
